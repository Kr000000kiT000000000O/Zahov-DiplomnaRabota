@model IReadOnlyList<BikeStore.Models.Bicycle>
@{ ViewData["Title"] = "Каталог"; var searchTerm = ViewData["Search"] as string; }
<div class="page-title"><p class="eyebrow">BIKESTORE / КАТАЛОГ</p><h1>Нашите велосипеди</h1></div>
<form method="get" class="searchbar">
    <label for="search">Търси модел или марка</label>
    <input id="search" name="search" type="search" value="@searchTerm" placeholder="Напр. DemoBike" />
    <button class="btn" type="submit">Търси</button>
</form>
<div class="cards">
@foreach(var bicycle in Model)
{
    <article class="product">
        <div class="product-visual" aria-hidden="true">🚲</div>
        <p class="eyebrow">@bicycle.Category.Name</p>
        <h2>@bicycle.Brand @bicycle.Name</h2>
        <p class="muted">Наличност: @bicycle.StockQuantity бр.</p>
        <p class="price">@bicycle.SalePrice.ToString("N2") €</p>
        <a asp-action="Details" asp-route-id="@bicycle.Id">Виж детайли →</a>
    </article>
}
</div>
@if(Model.Count == 0) { <p>Няма намерени велосипеди.</p> }
<p class="small">Цените и моделите са демонстрационни.</p>
