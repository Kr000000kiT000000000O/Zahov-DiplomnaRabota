@{ ViewData["Title"] = "Начало"; }
<section class="hero">
    <p class="eyebrow">ТВОЯТ ВЕЛОСИПЕД. ТВОЯТ МАРШРУТ.</p>
    <h1>Избери свободата<br />на две колела.</h1>
    <p>Разгледай каталог с примерни велосипеди за покупка или наемане. Това е начална демонстрационна версия.</p>
    <div class="actions">
        <a class="btn" asp-controller="Bicycles" asp-action="Index">Разгледай каталога</a>
        <a class="btn btn-outline" asp-controller="Rentals" asp-action="Index">Велосипеди под наем</a>
    </div>
</section>
<section class="features">
    <article class="feature"><span>01</span><h2>Каталог</h2><p>Търсене и преглед на велосипеди по категория и марка.</p></article>
    <article class="feature"><span>02</span><h2>Наемане</h2><p>Селекция на модели, предвидени за наемане.</p></article>
    <article class="feature"><span>03</span><h2>Потребители</h2><p>Регистрация, вход и отделни роли за служител и администратор.</p></article>
</section>
